# BASE HOME ASSISTANT (Épinglé en Python 3.13 pour éviter le bug de compilation de aubio sous Python 3.14)
FROM ghcr.io/home-assistant/base-python:3.13-alpine3.23

# DEPENDENCIES
RUN apk update && apk upgrade --no-cache && apk add --no-cache \
    alsa-plugins-pulse \
    g++ \
    gcc \
    git \
    linux-headers \
    make \
    nginx \
    portaudio-dev \
    python3-dev \
    eudev-dev

# PYTHON PIP UPGRADE
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

# INSTALL LEDFX (Fonctionnera directement sous Python 3.13)
RUN python3 -m pip install --no-cache-dir ledfx==2.2.1

# SENDSPIN FIX
RUN wget -qO "$(python3 -c 'import ledfx,os;print(os.path.dirname(ledfx.__file__))')/sendspin/stream.py" \
    https://raw.githubusercontent.com/LedFx/LedFx/d0423a6bd6c4044224515b35149a0e91a865cfe1/ledfx/sendspin/stream.py

# FILES
COPY rootfs /

# PERMISSIONS
RUN chmod a+x \
    "/etc/s6-overlay/s6-rc.d/init/run" \
    "/etc/s6-overlay/s6-rc.d/ledfx/run" \
    "/etc/s6-overlay/s6-rc.d/nginx/run"
